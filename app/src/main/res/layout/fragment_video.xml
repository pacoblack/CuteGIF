<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:padding="16dp">

  <!-- 类型选择下拉菜单 -->
  <Spinner
    android:id="@+id/Spinner"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:entries="@array/page_types"
    android:prompt="@string/select_type_prompt"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent"/>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/urlContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_toStartOf="@+id/btnGo"
    android:layout_marginHorizontal="8dp"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/Spinner"
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    tools:boxBackgroundColor="@android:color/white"
    tools:boxCornerRadius="24dp"
    tools:endIconMode="clear_text"
    tools:endIconTint="@color/dark"
    tools:hint="搜索或输入网址"
    >

    <com.google.android.material.textfield.MaterialAutoCompleteTextView
      android:id="@+id/urlInput"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:imeOptions="actionGo"
      android:inputType="textUri|textNoSuggestions|textMultiLine"
      android:maxLines="50"
      android:paddingVertical="12dp"
      android:textColor="@color/dark"
      android:textSize="14sp"
      />
  </com.google.android.material.textfield.TextInputLayout>
  <!-- 地址输入栏 -->
<!--  <EditText-->
<!--    android:id="@+id/etAddress"-->
<!--    android:layout_width="0dp"-->
<!--    android:layout_height="wrap_content"-->
<!--    android:layout_weight="1"-->
<!--    android:minLines="1"-->
<!--    android:maxLines="10"-->
<!--    android:ellipsize="end"-->
<!--    android:hint="输入"-->
<!--    android:inputType="textUri|textMultiLine"-->
<!--    android:imeOptions="actionGo"-->
<!--    tools:text=""/>-->

  <!-- 跳转按钮 -->
  <Button
    android:id="@+id/btnGo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="跳转"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/urlContainer"/>

</androidx.constraintlayout.widget.ConstraintLayout>